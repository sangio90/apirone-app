        "porto-admin-template":"http+cached://www.coridalia.cc/repository/porto-admin-template/porto-admin-template-light-4.1.0.zip",
        "kendoui":"http+cached://www.coridalia.cc/repository/kendoui/kendoui-2024.2.514.zip",
